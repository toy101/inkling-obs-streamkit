{
  "name": "api",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test ./test",
    "prepare:assets": "bun run ../../scripts/prepare-runtime-assets.ts api",
    "dev": "bun run prepare:assets && bun run --watch src/index.ts",
    "dev:json": "API_DATA_SOURCE=json bun run dev",
    "dev:d1:remote": "API_DATA_SOURCE=d1 bun run dev",
    "dev:d1": "bun run prepare:assets && bun run db:setup:local && bunx wrangler@4.136.3 dev --config wrangler.local.toml --local --port 8787 --persist-to .data/wrangler",
    "db:setup:local": "bun run src/db/setup-local.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:setup": "bun run db:seed"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.2",
    "@elysia/openapi": "^1.4.16",
    "elysia": "latest"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "module": "src/index.js"
}
