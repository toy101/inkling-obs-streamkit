# Elysia listen address and local Vite origins allowed by CORS.
API_HOST=127.0.0.1
API_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The API reads JSON files by default. Set this to turso to use the database.
API_DATA_SOURCE=json

# Loaded once before the API starts listening. The API exits if loading or validation fails.
WEAPON_CATALOG_URL=

# HTTPS origin used to resolve weapon images on demand.
IKACLO_API_ORIGIN=

# Local Turso development server. bun run db:dev derives its listen address from this URL.
TURSO_DATABASE_URL=http://127.0.0.1:8080

# Required only for a hosted Turso database. Keep credentials on the API server.
# TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
# TURSO_AUTH_TOKEN=
