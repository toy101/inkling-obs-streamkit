# Elysia listen address and local Vite origins allowed by CORS.
API_HOST=127.0.0.1
API_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The API reads JSON files by default. Set this to d1 to use Cloudflare D1.
API_DATA_SOURCE=json

# Loaded once before the API starts listening. The API exits if loading or validation fails.
CATALOG_URL=

# HTTPS origin used to resolve weapon images on demand.
# Also used by the local D1 Worker through a generated .dev.vars file.
IKACLO_API_ORIGIN=

# Required for local Bun API_DATA_SOURCE=d1 and the db:migrate/db:seed commands.
# The API Worker uses a DB binding instead and does not need this token.
# Grant D1 Read for local Bun queries; db:migrate/db:seed also require D1 Write.
# CLOUDFLARE_ACCOUNT_ID=
# D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=
